{
  "info": {
    "name": "Booking API (Lab 1)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "keycloakUrl",
      "value": "http://localhost:8180"
    },
    {
      "key": "clientId",
      "value": "booking-app"
    },
    {
      "key": "clientSecret",
      "value": "booking-secret"
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "manager_token",
      "value": ""
    },
    {
      "key": "user_token",
      "value": ""
    },
    {
      "key": "roomId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Tokens (Keycloak)",
      "item": [
        {
          "name": "Token ADMIN",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{keycloakUrl}}/realms/booking/protocol/openid-connect/token",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{clientSecret}}"
                },
                {
                  "key": "username",
                  "value": "admin"
                },
                {
                  "key": "password",
                  "value": "admin"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Token received\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"admin_token\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Token MANAGER",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{keycloakUrl}}/realms/booking/protocol/openid-connect/token",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{clientSecret}}"
                },
                {
                  "key": "username",
                  "value": "manager"
                },
                {
                  "key": "password",
                  "value": "manager"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Token received\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"manager_token\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Token USER",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{keycloakUrl}}/realms/booking/protocol/openid-connect/token",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{clientSecret}}"
                },
                {
                  "key": "username",
                  "value": "user"
                },
                {
                  "key": "password",
                  "value": "user"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Token received\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"user_token\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Rooms",
      "item": [
        {
          "name": "GET rooms as USER -> 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": "{{baseUrl}}/api/rooms"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET rooms without token -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/rooms"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST room as USER -> 403 (SecurityFilterChain)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/rooms",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lab {{$timestamp}}\",\n  \"capacity\": 8,\n  \"description\": \"Demo room\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST room as ADMIN -> 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/rooms",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lab {{$timestamp}}\",\n  \"capacity\": 8,\n  \"description\": \"Demo room\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"roomId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET room by id as USER -> 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": "{{baseUrl}}/api/rooms/{{roomId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT room as MANAGER -> 200",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{manager_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/rooms/{{roomId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lab {{$timestamp}} v2\",\n  \"capacity\": 10,\n  \"description\": \"Updated\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE room as MANAGER -> 403 (SecurityFilterChain, criterion 6)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{manager_token}}"
              }
            ],
            "url": "{{baseUrl}}/api/rooms/{{roomId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Bookings",
      "item": [
        {
          "name": "POST booking as USER -> 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": {{roomId}},\n  \"startTime\": \"2026-12-01T10:00:00\",\n  \"endTime\": \"2026-12-01T11:00:00\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"bookingId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET bookings as USER (own only) -> 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": "{{baseUrl}}/api/bookings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT booking as USER -> 200",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": {{roomId}},\n  \"startTime\": \"2026-12-01T12:00:00\",\n  \"endTime\": \"2026-12-01T13:00:00\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST confirm as USER -> 403 (@PreAuthorize, criterion 7)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}/confirm"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST confirm as MANAGER -> 200",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{manager_token}}"
              }
            ],
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}/confirm"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT confirmed booking as USER -> 409",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": {{roomId}},\n  \"startTime\": \"2026-12-01T12:00:00\",\n  \"endTime\": \"2026-12-01T13:00:00\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST cancel as USER -> 200",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}/cancel"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE booking as USER -> 204",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Cleanup",
      "item": [
        {
          "name": "DELETE room as ADMIN -> 204",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{baseUrl}}/api/rooms/{{roomId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}